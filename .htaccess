# --- 1. Never serve dotfiles (.env, .env.*, .gitignore, ...) ---
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# --- 2. Backup / scratch / log artefacts must not be downloadable ---
<FilesMatch "\.(bak|old|orig|save|swp|log|sql|ini|sh|lock|md)$">
    Require all denied
</FilesMatch>

# --- 3. Do not list directories ---
Options -Indexes