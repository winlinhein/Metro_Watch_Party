# Put these in Render → Environment (Dashboard → your web service → Environment).
# SMTP does not work reliably on Render; OTP and contact mail use the Resend HTTPS API.

# Required on Render.
RESEND_API_KEY=re_xxxxxxxx

# Must use a verified Resend domain. Gmail/Yahoo/Outlook addresses will be rejected.
MAIL_FROM=Nexus <noreply@nexuswatchparty.site>
MAIL_FROM_NAME=Nexus
CONTACT_TO=koz6122005@gmail.com
SMTP_USER=koz6122005@gmail.com

# Optional local Gmail SMTP (needs an app password for this Gmail).
SMTP_PASS=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# REQUIRED. The database credentials have no hardcoded fallback any more, so the
# app cannot connect unless these are set (in .env locally, or the host's
# environment on Render). Never commit real values.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional Google OAuth (falls back to google_oauth.local.php when present).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional. Mock Stripe/Pusher already work without these.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# PREMIUM_PRICE_ID=
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=ap1

# Optional TURN (camera/mic on school Wi-Fi). Leave blank to use Open Relay HMAC.
# TURN_HOST=staticauth.openrelay.metered.ca
# TURN_SECRET=openrelayprojectsecret
# TURN_USERNAME=
# TURN_CREDENTIAL=
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp
# METERED_TURN_APP=
# METERED_TURN_API_KEY=
